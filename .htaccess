# security headers (apache / cpanel)
# github pages ignores this, works on the company server
# keep CSP same as set-security.js

<IfModule mod_headers.c>
  # https only (turn on once https works)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # no framing
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
</IfModule>

# force https
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# hide notes, scripts, git, backups
<FilesMatch "^(README\.md|LICENSE|set-.*\.js|start-local\.bat|.*\.(bak|old|orig|log|sql|sh|bat|md))$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(git|github|vscode|claude)(/|$)
RedirectMatch 404 /\.(gitignore|gitattributes|env)$
Options -Indexes
ServerSignature Off

# 404 page
ErrorDocument 404 /404.html
