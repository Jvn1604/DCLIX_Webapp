# D-Clix website security headers for Apache / cPanel hosting.
# GitHub Pages ignores this file; it takes effect when the site is hosted on the company server.
# Keep the Content-Security-Policy in step with set-security.js (the <meta> tags in each page).

<IfModule mod_headers.c>
  # Browsers must only use HTTPS for this site for the next year (turn on only once HTTPS works)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Never let another website show these pages inside a frame (clickjacking)
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  # Do not guess file types; send only the site name to other websites; no camera/mic/location
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
</IfModule>

# Send everyone to HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Nothing in these files is meant for visitors: project notes, helper scripts, git data, backups
<FilesMatch "^(README\.md|LICENSE|set-.*\.js|start-local\.bat|.*\.(bak|old|orig|log|sql|sh|bat|md))$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(git|github|vscode|claude)(/|$)
RedirectMatch 404 /\.(gitignore|gitattributes|env)$
Options -Indexes
ServerSignature Off

# Friendly page for missing addresses
ErrorDocument 404 /404.html
