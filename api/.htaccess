# block config, lib, storage
<FilesMatch "^(config\.php|config\.example\.php|install\.php|schema\.sql)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(.*/)?api/(lib|storage|seed)(/|$)
Options -Indexes

# api = json only
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
  Header always set Referrer-Policy "no-referrer"
  Header always unset X-Powered-By
</IfModule>
# test payment page (mock mode only)
<Files "mock-gateway.php">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
  </IfModule>
</Files>
# pass auth header to php
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
